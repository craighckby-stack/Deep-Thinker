/**
 * @fileoverview AI Agent OS / Tessera Kernel Enterprise Environment Configuration Template
 * @module config/env.example
 *
 * 1. WHAT THE FILE DOES:
 *    Defines the baseline environment variable structure required for system execution, including
 *    API keys for multi-provider LLM failover (Gemini, OpenAI, DeepSeek, Anthropic, Local), sandbox boundaries,
 *    flat-file memory persistence directories, dynamic consensus weighting thresholds, and telemetry diagnostic settings.
 *
 * 2. ROLE IN THE OVERALL SYSTEM:
 *    Serves as the central configuration blueprint across containerized, local, edge (Termux), and enterprise environments,
 *    enabling environment validation drivers to assert environment readiness before boot.
 *
 * 3. HOW IT CONNECTS TO OTHER COMPONENTS:
 *    - Consumed by `src/lib/env-validator.ts` during runtime boot validation.
 *    - Checked by `lib/diagnostic-engine.ts` during startup system diagnostics.
 *    - Referenced by LLM multi-provider fallback routing engines, memory persistence modules, and Zero-Leak sandbox runners.
 */

# ==============================================================================
# AI AGENT OS / TESSERA KERNEL - ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# File: .env.example
# Role: Defines mandatory and optional environment settings for multi-provider
#       LLM fallback, Zero-Leak sandbox execution, flat-file memory persistence,
#       dynamic consensus weighting, and runtime diagnostic telemetry.
# Interoperability: Consumed by src/lib/env-validator.ts and lib/diagnostic-engine.ts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY & FALLBACK LLM PROVIDER API KEYS
# ------------------------------------------------------------------------------
# Google Gemini API key (Primary default provider)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (Secondary fallback model provider)
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API key (Specialized code/reasoning provider)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Anthropic Claude API key (Optional secondary fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local LLM Server Endpoint (e.g. Ollama, LM Studio, or Termux local kernel)
LOCAL_LLM_ENDPOINT=http://localhost:11434
LOCAL_LLM_MODEL=llama3:8b

# Default LLM Provider Routing Priority (Comma-separated)
# Options: gemini, openai, deepseek, anthropic, local
LLM_PROVIDER_PRIORITY=gemini,openai,deepseek,local

# ------------------------------------------------------------------------------
# 2. ZERO-LEAK SANDBOX & MEMORY PERSISTENCE CONFIGURATION
# ------------------------------------------------------------------------------
# Directory path for flat-file memory and vector persistence
MEMORY_PERSISTENCE_DIR=./memory

# Zero-Leak sandbox memory boundary limit per execution thread (in MB)
SANDBOX_MAX_MEMORY_MB=512

# Zero-Leak sandbox strict execution timeout (in milliseconds)
SANDBOX_TIMEOUT_MS=30000

# Strict garbage collection trigger frequency (in cycles)
SANDBOX_GC_FREQUENCY=100

# ------------------------------------------------------------------------------
# 3. DYNAMIC CONSENSUS WEIGHTING & AGENT DEBATE PARAMETERS
# ------------------------------------------------------------------------------
# Consensus acceptance threshold (0.00 to 1.00)
CONSENSUS_THRESHOLD=0.75

# Dynamic agent weight attenuation factor on reasoning conflict (0.01 to 0.50)
ATTENUATION_FACTOR=0.10

# Maximum debate rounds before triggering arbitrator fallback
MAX_CONSENSUS_ROUNDS=3

# ------------------------------------------------------------------------------
# 4. ARCHITECTURAL DIAGNOSTIC ENGINE & TELEMETRY
# ------------------------------------------------------------------------------
# Enable or disable automated runtime diagnostic suite on startup
DIAGNOSTICS_ENABLED=true

# System log verbosity: error, warn, info, debug, trace
LOG_LEVEL=info

# Health check HTTP telemetry server port
DIAGNOSTIC_PORT=9090